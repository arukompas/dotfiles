#!/usr/bin/env bash

set -euo pipefail

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Symlink $1 to $2, moving any pre-existing real file or directory aside first.
# An existing symlink is just replaced -- removing it never touches its target.
link() {
    local src=$1 dest=$2 backup n

    mkdir -p "$(dirname "$dest")"

    if [ -L "$dest" ]; then
        rm -f "$dest"
    elif [ -e "$dest" ]; then
        backup="$dest.bak"
        n=1
        while [ -e "$backup" ]; do
            backup="$dest.bak.$n"
            n=$((n + 1))
        done
        mv "$dest" "$backup"
        echo "backed up $dest -> $backup"
    fi

    ln -s "$src" "$dest"
}

link "$DOTFILES/zsh/zshrc" "$HOME/.zshrc"
link "$DOTFILES/zsh/zshrcprivate" "$HOME/.zshrcprivate"
link "$DOTFILES/zsh/p10k.zsh" "$HOME/.p10k.zsh"
link "$DOTFILES/vim" "$HOME/.vim"
link "$DOTFILES/tmux/tmux.conf" "$HOME/.tmux.conf"
link "$DOTFILES/scripts/t" "$HOME/.local/bin/t"
link "$DOTFILES/phpactor" "$HOME/.config/phpactor"
link "$DOTFILES/worktrunk" "$HOME/.config/worktrunk"
link "$DOTFILES/herdr/config.toml" "$HOME/.config/herdr/config.toml"
